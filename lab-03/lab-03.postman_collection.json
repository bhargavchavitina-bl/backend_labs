      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('All books are within price range 250 to 400', function () {",
              "    const data = pm.response.json();",
              "    data.forEach(book => {",
              "        pm.expect(book.price).to.be.at.least(250);",
              "        pm.expect(book.price).to.be.at.most(400);",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
