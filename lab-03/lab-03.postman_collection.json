              "key": "min_price",
              "value": "200"
            },
            {
              "key": "max_price",
              "value": "500"
            },
            {
              "key": "order_by",
              "value": "pages"
            },
            {
              "key": "order",
              "value": "DESC"
            },
            {
              "key": "limit",
              "value": "2"
            },
            {
              "key": "offset",
              "value": "1"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Returns filtered array with max 2 items', function () {",
              "    const data = pm.response.json();",
              "    pm.expect(Array.isArray(data)).to.be.true;",
              "    pm.expect(data.length).to.be.at.most(2);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 SQL injection text in search is harmless",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/?search_q=%27%20OR%201%3D1%20--",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            ""
          ],
          "query": [
            {
              "key": "search_q",
              "value": "' OR 1=1 --"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('SQL injection literal string treated safely', function () {",
              "    const data = pm.response.json();",
              "    pm.expect(Array.isArray(data)).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "09 POST create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Test Book\",\"author\":\"Test Author\",\"price\":350,\"pages\":280}"
        },
        "url": {
          "raw": "{{baseUrl}}/books/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
              "const data = pm.response.json();",
              "pm.test('Returns new book ID and message', function () {",
              "    pm.expect(data.id).to.be.a('number');",
              "});",
              "pm.collectionVariables.set('newBookId', String(data.id));"
            ]
          }
        }
      ]
    },
