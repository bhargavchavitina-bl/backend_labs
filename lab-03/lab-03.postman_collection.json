{
  "info": {
    "name": "Lab 3 REST API tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "newBookId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 GET all books (defaults)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Returns array of books', function () {",
              "    const data = pm.response.json();",
              "    pm.expect(Array.isArray(data)).to.be.true;",
              "    pm.expect(data.length).to.be.above(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 GET /books/3/",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/3/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "3",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Returns book with id 3', function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.id).to.eql(3);",
              "    pm.expect(data.title).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 search_q=the",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/?search_q=the",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            ""
          ],
          "query": [
            {
              "key": "search_q",
              "value": "the"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('All returned books contain search query in title', function () {",
              "    const data = pm.response.json();",
              "    pm.expect(Array.isArray(data)).to.be.true;",
              "    data.forEach(book => pm.expect(book.title.toLowerCase()).to.include('the'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 order_by=price&order=DESC&limit=5",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/?order_by=price&order=DESC&limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            ""
          ],
          "query": [
            {
              "key": "order_by",
              "value": "price"
            },
            {
              "key": "order",
              "value": "DESC"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Returns max 5 books sorted descending by price', function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.length).to.be.at.most(5);",
              "    for (let i = 0; i < data.length - 1; i++) {",
              "        pm.expect(data[i].price).to.be.at.least(data[i + 1].price);",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
